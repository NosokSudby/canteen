# Ignore Unity-generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Ignore asset meta files created when Unity imports assets
*.pidb
*.booproj
*.suo
*.user
*.userprefs
*.unityproj
*.log
*.stackdump
*.svd

# Ignore build files
*.apk
*.aab
*.exe
*.app
*.msi
*.dmg
*.ipa
*.class
*.jar
*.java
*.dll
*.pdb
*.mdb
*.so
*.dylib
*.nib
*.xib
*.plist
*.a
*.o
*.prx

# Ignore crash reports
sysinfo.txt

# Ignore Unity Editor cache
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.hash
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.json

# Visual Studio cache and files
.vscode/
.vs/
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userosscache
*.userprefs
*.unityproj

# Exclude JetBrains Rider files
.idea/
*.iml
*.iws

# Ignore Mac system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
Thumbs.db

# Ignore files created by Windows
*.stackdump
*.swp

# Ignore auto-generated Play Mode Test Results
Assets/StreamingAssets/UnityEngine.TestRunner/

# TextMesh Pro files
[Tt]ext[Mm]esh[Pp]ro/[Gg]enerated/

# Include these files if needed
!Assets/AddressableAssetsData/*.asset
!Assets/**/*.meta
canteen/Library/ArtifactDB
canteen/Library/SourceAssetDB
canteen/Logs/AssetImportWorker0-prev.log
canteen/Logs/AssetImportWorker0.log
canteen/Logs/AssetImportWorker1-prev.log
canteen/Logs/AssetImportWorker1.log
canteen/Logs/shadercompiler-AssetImportWorker0.log
